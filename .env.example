# GreenPlus.Ai — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored; this file is committed as documentation.
#
# ─────────────────────────────────────────────────────────────────
# REQUIRED — Supabase (frontend + Edge Function URL construction)
# ─────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# ─────────────────────────────────────────────────────────────────
# OPTIONAL — Sentry error monitoring
# ─────────────────────────────────────────────────────────────────
# Leave empty to disable Sentry (it is gated on !!VITE_SENTRY_DSN).
# Find the DSN in: Sentry Dashboard → Project → Settings → Client Keys
VITE_SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────
# OPTIONAL — Vertex AI (legacy fallback scan path)
# ─────────────────────────────────────────────────────────────────
# Used only if the Vertex AI backend is enabled in the admin AI settings.
# VITE_VERTEX_ACCESS_TOKEN is a short-lived OAuth2 token — DO NOT put it
# in GitHub Secrets or any CI workflow. Set it manually in the admin UI
# (Settings → AI → Vertex AI) and it will be persisted in localStorage.
VITE_VERTEX_PROJECT_ID=
VITE_VERTEX_LOCATION=us-central1
# VITE_VERTEX_ACCESS_TOKEN — set via admin UI only, never in files or CI

# ─────────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY — Supabase Edge Function secrets
# ─────────────────────────────────────────────────────────────────
# These are NOT VITE_ vars — they are never bundled into the frontend.
# Set them in: Supabase Dashboard → Edge Functions → Secrets
#
#   ANTHROPIC_API_KEY=sk-ant-...   (required for classify-waste function)
#   SUPABASE_URL                   (auto-injected by Supabase)
#   SUPABASE_ANON_KEY              (auto-injected by Supabase)

# ─────────────────────────────────────────────────────────────────
# CI/CD — GitHub Actions secrets (set in repo Settings → Secrets)
# ─────────────────────────────────────────────────────────────────
# Required for build and deployment:
#   VITE_SUPABASE_URL      — same value as above
#   VITE_SUPABASE_ANON_KEY — same value as above
#   VITE_SENTRY_DSN        — optional; omit or leave empty to skip Sentry
#
# Required for Vercel deployment (optional — build still runs without them):
#   VERCEL_TOKEN           — from vercel.com/account/tokens
#   VERCEL_ORG_ID          — from vercel.com/account (team ID or personal)
#   VERCEL_PROJECT_ID      — from Vercel project settings
