{
  "project": "GreenPlus Ai",
  "register": "product",
  "generated": "2026-05-21",
  "tokens": {
    "colors": {
      "ink":        { "light": "#1A1A1A", "dark": "#FAFAF7", "role": "primary text, borders, shadows" },
      "ink-2":      { "light": "#3A3A3A", "dark": "#D8D8D0", "role": "secondary text" },
      "ink-3":      { "light": "#7A7A7A", "dark": "#9A9A92", "role": "muted labels, placeholders" },
      "ink-4":      { "light": "#B8B8B8", "dark": "#4A4A48", "role": "disabled, dividers" },
      "paper":      { "light": "#FAFAF7", "dark": "#151512", "role": "page background" },
      "paper-2":    { "light": "#F1EFE8", "dark": "#1E1E1A", "role": "card/section background" },
      "green":      { "light": "#22C55E", "dark": "#22C55E", "role": "primary action, accepted state" },
      "green-soft": { "light": "rgba(34,197,94,.14)", "dark": "rgba(34,197,94,.18)", "role": "tinted highlight, avatar bg" },
      "green-ink":  { "light": "#0F7A3A", "dark": "#4ADE80", "role": "green text on surface" },
      "orange":     { "light": "#F59E0B", "dark": "#FBBF24", "role": "warning, flagged, degraded" },
      "blue":       { "light": "#5BC0BE", "dark": "#5BC0BE", "role": "map, location, distance" }
    },
    "fonts": {
      "brand": "'Architects Daughter', Mitr, sans-serif",
      "body":  "Caveat, Sarabun, sans-serif",
      "data":  "'JetBrains Mono', 'IBM Plex Sans Thai', monospace"
    },
    "shadows": {
      "resting":  "2px 2px 0 var(--ink)",
      "lifted":   "3px 3px 0 var(--ink)",
      "modal":    "4px 4px 0 var(--ink)",
      "pressed":  "none"
    },
    "borders": {
      "standard": "1.5px solid var(--ink)",
      "quiet":    "1px solid var(--ink-4)"
    },
    "radius": "0"
  },
  "components": {
    "Button": {
      "variants": ["primary", "secondary", "ghost"],
      "primary": { "bg": "var(--green)", "color": "#062040" },
      "secondary": { "bg": "var(--paper)", "color": "var(--ink)" },
      "ghost": { "bg": "transparent", "border": "none", "shadow": "none" },
      "minHeight": "44px",
      "border": "1.5px solid var(--ink)",
      "shadow": "2px 2px 0 var(--ink)",
      "transition": "transform 0.075s, box-shadow 0.075s"
    },
    "Card": {
      "bg": "var(--paper-2)",
      "border": "1.5px solid var(--ink)",
      "shadow": "2px 2px 0 var(--ink)",
      "hoverShadow": "3px 3px 0 var(--ink)",
      "padding": "1rem"
    },
    "Chip": {
      "variants": ["default", "soft", "green", "orange"],
      "font": "var(--font-data)",
      "fontSize": "11px",
      "textTransform": "uppercase",
      "letterSpacing": "0.1em"
    },
    "KpiCard": {
      "label": { "font": "var(--font-data)", "size": "10px", "color": "var(--ink-3)", "textTransform": "uppercase" },
      "value": { "font": "var(--font-brand)", "size": "2rem", "color": "var(--ink)" },
      "trendUp": { "color": "var(--green-ink)" },
      "trendDown": { "color": "var(--orange)" }
    }
  },
  "animations": {
    "scanLaser": "2.4s ease-in-out infinite",
    "bboxDraw": "0.35s ease-out forwards",
    "mapPing": "1.4s cubic-bezier(0,0,0.2,1) infinite",
    "flaggedPulse": "1.3s ease-in-out infinite",
    "shimmer": "1.4s ease infinite",
    "reducedMotion": "all disabled"
  }
}
